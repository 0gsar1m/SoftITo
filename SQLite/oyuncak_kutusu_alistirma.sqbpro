<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="oyuncak_kutusu_alistirma.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1160"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="Oyuncaklar" custom_title="0" dock_id="3" table="4,10:mainOyuncaklar"/><dock_state state=""/><default_encoding codec=""/><browse_table_settings><table schema="main" name="Oyuncaklar" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="29"/><column index="2" value="67"/><column index="3" value="72"/><column index="4" value="56"/><column index="5" value="78"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">CREATE TABLE Oyuncaklar (
	id	INTEGER PRIMARY KEY AUTOINCREMENT,
	isim	TEXT NOT NULL,
	cesit	TEXT,
	fiyat	INTEGER CHECK(fiyat &gt; 0),
	renk	TEXT DEFAULT 'kırmızı'
);

--VERI EKLEME 
INSERT INTO Oyuncaklar (isim,cesit,fiyat) VALUES ('Şimşek','araba',50);
INSERT INTO Oyuncaklar (isim,cesit,fiyat,renk) VALUES 
('Ayıcık', 'peluş', 80, 'kahverengi'),
('Kale Seti', 'lego', 150, 'gri'),
('Zıpzıp ', 'top', 20, 'sarı'),
('Barbi ', 'bebek', 90, 'pembe')
;

--VERI BULMA 
SELECT * FROM Oyuncaklar;
SELECT isim,fiyat FROM Oyuncaklar WHERE fiyat &gt; 80;
SELECT * FROM Oyuncaklar ORDER BY fiyat DESC LIMIT 2; 
SELECT * FROM Oyuncaklar WHERE isim LIKE 'Z%';
SELECT * FROM Oyuncaklar WHERE cesit IN ('araba', 'top');
SELECT * FROM Oyuncaklar WHERE fiyat BETWEEN 20 and 60;

--UPDATE DELETE
UPDATE Oyuncaklar SET renk = 'mavi' WHERE isim = 'Şimşek';
DELETE FROM Oyuncaklar WHERE isim = 'Zıpzıp ';
--DELETE FROM Oyuncaklar; --&gt; Tablodaki tüm veriyi siler
ALTER TABLE Oyuncaklar ADD COLUMN kimin TEXT;
UPDATE Oyuncaklar SET kimin = 'Ali' WHERE isim = 'Kale Seti';
ALTER TABLE Oyuncaklar RENAME COLUMN cesit TO tur;
</sql><current_tab id="0"/></tab_sql></sqlb_project>
